{
  "name": "reading-comfort-pacer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:site": "vite --config vite.site.config.ts",
    "build:extension": "wxt build",
    "build:site": "vite build --config vite.site.config.ts",
    "package:extension": "node scripts/package-extension.mjs",
    "build": "npm run clean && npm run build:extension && npm run build:site && npm run package:extension",
    "clean": "node scripts/clean.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "tsc --noEmit && npm test && npm run build"
  },
  "dependencies": {
    "@fontsource-variable/atkinson-hyperlegible-next": "5.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.58.2",
    "@types/chrome": "0.2.7",
    "archiver": "8.0.0",
    "playwright": "1.58.2",
    "sharp": "0.35.4",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "wxt": "0.21.4"
  }
}
